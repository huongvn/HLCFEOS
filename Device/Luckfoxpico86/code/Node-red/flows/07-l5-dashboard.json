    "name": "Build log query",
    "func": "const devId = (typeof msg.payload === 'string' && msg.payload !== 'refresh') ? msg.payload : 'all';\nconst filter = devId === 'all' ? '%' : devId;\nmsg.topic = `SELECT ts, device_id, event, payload FROM device_log WHERE device_id LIKE ? ORDER BY ts DESC LIMIT 100`;\nmsg.params = [filter];\nreturn msg;",
