  {
    "id": "fn-l5-schedule-crud",
    "type": "function",
    "z": "tab-l5",
    "name": "Schedule CRUD",
    "func": "const f   = msg.payload;\nconst now = new Date().toISOString();\nif (!f.name || !f.device_id || !f.action) { node.warn('Missing fields'); return null; }\n\nconst minute = String(f.minute ?? '*');\nconst hour   = String(f.hour   ?? '*');\nconst dow    = f.dow ?? '*';\nconst params = f.action_params || null;\n\nmsg.topic = `INSERT INTO schedule (name, device_id, device_type, action, action_params, sch_minute, sch_hour, sch_dow, enabled, one_shot, created_at) VALUES (?,?,?,?,?,?,?,?,?,?,?)`;\nmsg.params = [f.name, f.device_id, '', f.action, params, minute, hour, dow, f.enabled ? 1 : 0, f.one_shot ? 1 : 0, now];\nreturn [msg, msg];",
    "outputs": 2,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "sql-l5-schedule-crud"
      ],
      [
        "fn-l5-reload-sched"
      ]
    ]
  },
  {
    "id": "sql-l5-schedule-crud",
    "type": "sqlite",
    "z": "tab-l5",
