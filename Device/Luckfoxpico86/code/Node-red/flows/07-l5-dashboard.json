  {
    "id": "fn-l5-build-manual",
    "type": "function",
    "z": "tab-l5",
    "name": "Build manual ZbSend (generic)",
    "func": "// ── L5: GENERIC manual command builder ────────────────────────\nconst deviceId = flow.get('manual_device_id');\nif (!deviceId) { node.warn('No device selected'); return null; }\n\nconst configs = global.get('device_configs') || {};\nconst cfg = configs[deviceId];\nif (!cfg || !cfg.extra) { node.warn(`No config for ${deviceId}`); return null; }\n\nconst extra = cfg.extra;\nconst gateway = cfg.gateway || extra.gateway;\nconst powerAttr = extra.power_attr || '0110';\nconst val = msg.payload === 'ON' ? 1 : 0;\n\nmsg.topic   = `cmnd/${gateway}/ZbSend`;\nmsg.payload = JSON.stringify({\n    device: deviceId,\n    send: { Cluster: '0xEF00', Write: { [powerAttr]: val } }\n});\nmsg._manual_device_id = deviceId;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "mqtt-l5-manual"
      ]
    ]
  },
  {
    "id": "mqtt-l5-manual",
    "type": "mqtt out",
    "z": "tab-l5",
    "name": "Publish ZbSend manual",
    "topic": "",
    "qos": "1",
    "retain": "false",
    "respTopic": "",
    "contentType": "",
    "userProps": "",
    "correl": "",
    "expiry": "",
    "broker": "cfg-mqtt-broker",
    "wires": [
      [
        "fn-l5-log-manual"
      ]
    ]
  },
  {
    "id": "fn-l5-log-manual",
    "type": "function",
    "z": "tab-l5",
    "name": "Log manual command",
    "func": "const now = new Date().toISOString();\nmsg.topic   = 'INSERT INTO device_log (ts, device_id, device_type, location, payload, event) VALUES (?,?,?,?,?,?)';\nmsg.params = [now, msg._manual_device_id || 'unknown', 'unknown', '', JSON.stringify({ manual: msg.payload }), 'manual_command'];\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "sql-l5-log-manual"
      ]
    ]
  },
