  {
    "id": "fn-l5-add-device",
    "type": "function",
    "z": "tab-l5",
    "name": "Build INSERT device_config",
    "func": "// ── L5: Add/Update device_config ─────────────────────────────\nconst f = msg.payload;\nif (!f.device_id || !f.device_type) { node.warn('Missing device_id or device_type'); return null; }\n\n// Build extra JSON\nconst extra = {};\nif (f.gateway) extra.gateway = f.gateway;\nif (f.power_attr) extra.power_attr = f.power_attr;\nif (f.ac_power_attr) extra.ac_power_attr = f.ac_power_attr;\nif (f.ac_temp_attr) extra.ac_temp_attr = f.ac_temp_attr;\nif (f.ac_mode_attr) extra.ac_mode_attr = f.ac_mode_attr;\nif (f.ac_mode_map) {\n    try { extra.ac_mode_map = JSON.parse(f.ac_mode_map); } catch(e) { node.warn('Invalid ac_mode_map JSON'); }\n}\nif (f.attrs_json) {\n    try { extra.attrs = JSON.parse(f.attrs_json); } catch(e) { node.warn('Invalid attrs JSON'); }\n}\nif (f.custom_actions_json) {\n    try { extra.custom_actions = JSON.parse(f.custom_actions_json); } catch(e) { node.warn('Invalid custom_actions JSON'); }\n}\n\nmsg.topic = `INSERT OR REPLACE INTO device_config (device_id, device_type, location, friendly_name, enabled, extra) VALUES (?,?,?,?,?,?)`;\nmsg.params = [\n    f.device_id,\n    f.device_type,\n    f.location || '',\n    f.friendly_name || '',\n    f.enabled ? 1 : 0,\n    JSON.stringify(extra)\n];\n\nmsg._reload_needed = true;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "sql-l5-add-device",
        "fn-l5-reload-configs"
      ]
    ]
  },
  {
    "id": "sql-l5-add-device",
    "type": "sqlite",
    "z": "tab-l5",
    "name": "INSERT/REPLACE device_config",
    "mydb": "cfg-sqlite-db",
    "sqlquery": "msg.topic",
    "sql": "",
    "wires": []
  },
  {
    "id": "fn-l5-reload-configs",
    "type": "function",
    "z": "tab-l5",
    "name": "Reload configs -> global",
    "func": "// ── L5: Reload device_configs vao global ─────────────────────\nconst reload = flow.get('_force_reload') || msg._reload_needed;\nif (!reload && !msg._reload_needed) return null;\n\nmsg.topic   = 'SELECT * FROM device_config WHERE enabled = 1';\nmsg.params = [];\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "sql-l5-load-configs"
      ]
    ]
  },
  {
    "id": "sql-l5-load-configs",
    "type": "sqlite",
    "z": "tab-l5",
    "name": "SELECT all configs",
    "mydb": "cfg-sqlite-db",
    "sqlquery": "msg.topic",
    "sql": "",
    "wires": [
      [
        "fn-l5-parse-configs"
      ]
    ]
  },
  {
    "id": "fn-l5-parse-configs",
    "type": "function",
    "z": "tab-l5",
    "name": "Parse configs -> global",
    "func": "const rows = msg.payload || [];\nconst configs = {};\nrows.forEach(row => {\n    configs[row.device_id] = {\n        type:          row.device_type,\n        location:      row.location,\n        friendly_name: row.friendly_name,\n        enabled:       row.enabled,\n        gateway:       (row.extra ? JSON.parse(row.extra) : {}).gateway || '',\n        extra:         row.extra ? JSON.parse(row.extra) : {},\n    };\n});\nglobal.set('device_configs', configs);\nnode.status({ fill: 'green', shape: 'dot', text: `${Object.keys(configs).length} configs loaded` });\nnode.warn(`[Reload] ${Object.keys(configs).length} device configs loaded`);\nreturn null;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": []
  },
