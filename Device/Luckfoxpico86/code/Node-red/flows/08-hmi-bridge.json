[
  {
    "id": "tab-hmi",
    "type": "tab",
    "label": "HMI Send Only",
    "disabled": false,
    "info": "Chi nhan lenh ON/OFF tu LVGL, khong phan hoi trang thai"
  },
  {
    "id": "cfg-mqtt-broker",
    "type": "mqtt-broker",
    "name": "NanoMQ Local",
    "broker": "localhost",
    "port": "1883",
    "clientid": "nodered_hmi_ac",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "5",
    "keepalive": "60",
    "cleansession": true,
    "birthTopic": "",
    "willTopic": "",
    "willPayload": "",
    "willQos": "0",
    "willRetain": false
  },
  {
    "id": "mqtt-hmi-subscribe",
    "type": "mqtt in",
    "z": "tab-hmi",
    "name": "Subscribe ON/OFF only",
    "topic": "bms/ac/+/power/set",
    "qos": "1",
    "datatype": "utf8",
    "broker": "cfg-mqtt-broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "wires": [
      [
        "dbg-hmi-in",
        "fn-hmi-parse-set"
      ]
    ]
  },
  {
    "id": "fn-hmi-parse-set",
    "type": "function",
    "z": "tab-hmi",
    "name": "Parse AC set → ZbSend",
    "func": "const topic = msg.topic;\nconst payload = msg.payload;\nconst parts = topic.split('/');\n\nconst configs = global.get('device_configs') || {};\nconst acIds = Object.keys(configs)\n    .filter(id => configs[id].type === 'ac_controller')\n    .sort();\n\nconst idx = parseInt(parts[2]);\nconst deviceId = acIds[idx];\nif (!deviceId) return null;\n\nconst cfg = configs[deviceId];\nconst ex = cfg.extra || {};\nconst gateway = cfg.gateway || ex.gateway;\nconst val = payload === 'ON' ? 1 : 0;\n\nmsg.topic = 'cmnd/' + gateway + '/ZbSend';\nmsg.payload = JSON.stringify({ Device: deviceId, Write: { ['EF00/' + (ex.power_attr || '0101')]: val } });\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "mqtt-hmi-cmd-out"
      ]
    ]
  },
  {
    "id": "mqtt-hmi-cmd-out",
    "type": "mqtt out",
    "z": "tab-hmi",
    "name": "Publish ZbSend",
    "topic": "",
    "qos": "1",
    "retain": "false",
    "respTopic": "",
    "contentType": "",
    "userProps": "",
    "correl": "",
    "expiry": "",
    "broker": "cfg-mqtt-broker",
    "wires": []
  },
  {
    "id": "dbg-hmi-cmd",
    "type": "debug",
    "z": "tab-hmi",
    "name": "HMI cmd debug",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": true,
    "complete": "true",
    "targetType": "full",
    "statusVal": "_hmi_cmd.action",
    "statusType": "msg",
    "wires": []
  }
]