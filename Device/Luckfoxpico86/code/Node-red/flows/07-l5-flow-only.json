  {
    "id": "fn-l5-parse-configs",
    "type": "function",
    "z": "tab-l5",
    "name": "Parse configs -> global",
    "func": "const rows = msg.payload || [];\nconst configs = {};\nrows.forEach(row => {\n    const extra = row.extra ? JSON.parse(row.extra) : {};\n    configs[row.device_id] = { type: row.device_type, location: row.location, friendly_name: row.friendly_name, enabled: row.enabled, gateway: extra.gateway || '', extra: extra };\n});\nglobal.set('device_configs', configs);\nnode.warn('[Reload] ' + Object.keys(configs).length + ' device configs loaded');\nreturn null;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": []
  },
