  {
    "id": "fn-l5-sched-store",
    "type": "function",
    "z": "tab-l5",
    "name": "Store schedule form values",
    "func": "const form = flow.get('sched_form') || {};\nconst topic = msg.topic || '';\n\n// Xac dinh field nao dang duoc gui (dung _msgid or widget index)\n// Dung msg.payload de nhan biet kieu: string -> name/device_id/params/dow, number -> hour/minute\nconst label = (msg.ui || {}).label || '';\nif (label.includes('Ten lich')) form.name = msg.payload;\nelse if (label.includes('Device ID')) form.device_id = msg.payload;\nelse if (label.includes('Hanh dong')) form.action = msg.payload;\nelse if (label.includes('Action params')) form.action_params = msg.payload;\nelse if (label.includes('Gio')) form.hour = msg.payload;\nelse if (label.includes('Phut')) form.minute = msg.payload;\nelse if (label.includes('Ngay')) form.dow = msg.payload;\nelse if (label.includes('Chay 1 lan')) form.one_shot = msg.payload;\nelse if (label.includes('Kich hoat')) form.enabled = msg.payload;\n\nflow.set('sched_form', form);\nreturn null;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": []
  },
