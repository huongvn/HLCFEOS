  {
    "id": "fn-l5-ac-cmd",
    "type": "function",
    "z": "tab-l5",
    "name": "Build AC ZbSend",
    "func": "const configs = global.get('device_configs') || {};\nconst acEntry = Object.entries(configs).find(function(e) { return e[1].type === 'ac_controller'; });\nif (!acEntry) { node.warn('No ac_controller in config'); return null; }\n\nconst acId  = acEntry[0];\nconst extra = acEntry[1].extra || {};\nconst gateway = acEntry[1].gateway || extra.gateway;\nconst ctx = flow.get('ac_control') || {};\n\nconst writes = {};\nwrites[extra.ac_power_attr || '0101'] = 1;\nwrites[extra.ac_temp_attr  || '0202'] = ctx.temp || 24;\nconst modeMap = extra.ac_mode_map || { off: 0, cool: 1, heat: 2, fan_only: 3, dry: 4 };\nwrites[extra.ac_mode_attr  || '0405'] = modeMap[ctx.mode] !== undefined ? modeMap[ctx.mode] : 1;\n\nmsg.topic   = 'cmnd/' + gateway + '/ZbSend';\nmsg.payload = JSON.stringify({ device: acId, send: { Cluster: '0xEF00', Write: writes } });\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "wires": [
      [
        "mqtt-l5-ac"
      ]
    ]
  },
