  {
    "id": "fn-l5-devcfg-store",
    "type": "function",
    "z": "tab-l5",
    "name": "Store device config form",
    "func": "const form = flow.get('dev_config') || {};\nconst label = (msg.ui || {}).label || '';\nif (label.includes('Device ID')) form.device_id = msg.payload;\nelse if (label.includes('Device Type')) form.device_type = msg.payload;\nelse if (label.includes('Gateway')) form.gateway = msg.payload;\nelse if (label.includes('Location')) form.location = msg.payload;\nelse if (label.includes('Friendly')) form.friendly_name = msg.payload;\nelse if (label.includes('Power attr')) form.power_attr = msg.payload;\nelse if (label.includes('Attrs mapping')) form.attrs_json = msg.payload;\nelse if (label.includes('Custom actions')) form.custom_actions_json = msg.payload;\nflow.set('dev_config', form);\nreturn null;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": []
  },
