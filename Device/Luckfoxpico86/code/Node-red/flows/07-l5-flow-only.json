  {
    "id": "fn-l5-schedule-crud",
    "type": "function",
    "z": "tab-l5",
    "name": "Schedule CRUD",
    "func": "function esc(v) { if (v === null || v === undefined) return 'NULL'; if (typeof v === 'number') return String(v); return \"'\" + String(v).replace(/'/g, \"''\") + \"'\"; }\nconst f = flow.get('sched_form') || {};\nconst now = new Date().toISOString();\nif (!f.name || !f.device_id || !f.action) { node.warn('Missing fields: name, device_id, action'); return null; }\nconst min = String(f.minute ?? '*');\nconst hour = String(f.hour ?? '*');\nconst dow = f.dow || '*';\nconst params = f.action_params || null;\nconst vals = [f.name, f.device_id, f.action, params ? String(params) : 'NULL', min, hour, dow, f.enabled === '1' ? '1' : '0', f.one_shot === '1' ? '1' : '0', now];\nmsg.topic = 'INSERT INTO schedule (name, device_id, action, action_params, sch_minute, sch_hour, sch_dow, enabled, one_shot, created_at) VALUES (' + vals.map(esc).join(',') + ')';\nreturn [msg, msg];",
    "outputs": 2,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "sql-l5-schedule-crud"
      ],
      [
        "fn-l5-reload-sched"
      ]
    ]
  },
  {
    "id": "sql-l5-schedule-crud",
    "type": "sqlite",
    "z": "tab-l5",
    "name": "INSERT schedule",
    "mydb": "cfg-sqlite-db",
    "sqlquery": "msg.topic",
    "sql": "",
    "wires": []
  },
