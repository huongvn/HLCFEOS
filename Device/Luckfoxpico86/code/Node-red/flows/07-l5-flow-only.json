  {
    "id": "fn-l5-log-manual",
    "type": "function",
    "z": "tab-l5",
    "name": "Log manual cmd",
    "func": "function esc(v) { if (v === null || v === undefined) return 'NULL'; if (typeof v === 'number') return String(v); return \"'\" + String(v).replace(/'/g, \"''\") + \"'\"; }\nconst now = new Date().toISOString();\nconst did = msg._manual_device_id || 'unknown';\nconst vals = [now, did, 'unknown', '', JSON.stringify({ manual: msg.payload }), 'manual_command'];\nmsg.topic = 'INSERT INTO device_log (ts, device_id, device_type, location, payload, event) VALUES (' + vals.map(esc).join(',') + ')';\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
