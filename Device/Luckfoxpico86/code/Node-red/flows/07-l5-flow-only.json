  {
    "id": "fn-l5-device-cards",
    "type": "function",
    "z": "tab-l5",
    "name": "Build device cards",
    "func": "const devices = global.get(\"devices\") ?? {};\nconst configs = global.get(\"device_configs\") ?? {};\nconst rows = Object.values(devices).map(d => ({\n    ID: d.id,\n    Ten: configs[d.id]?.friendly_name ?? d.id,\n    Loai: d.type,\n    Gateway: d.gateway || \"—\",\n    \"Trang thai\": d.state?.power !== undefined ? (d.state.power ? \"ON\" : \"OFF\") : (d.state?.temperature !== undefined ? d.state.temperature + \"°C\" : \"—\"),\n    Online: d.state?.online ? \"✓\" : \"✗\",\n    LinkQ: d.state?.link_quality ?? \"—\",\n    \"Cap nhat\": d.ts ? d.ts.slice(11, 19) : \"—\",\n}));\n// Gui [] de clear truoc, roi gui data\nreturn [\n  { payload: [] },\n  { payload: rows }\n];",
    "outputs": 2,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "ui-table-devices"
      ],
      [
        "ui-table-devices"
      ]
    ]
  },
