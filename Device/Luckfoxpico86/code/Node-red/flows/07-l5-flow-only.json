  {
    "id": "fn-l5-add-device",
    "type": "function",
    "z": "tab-l5",
    "name": "Build INSERT device_config",
    "func": "function esc(v) { if (v === null || v === undefined) return 'NULL'; if (typeof v === 'number') return String(v); return \"'\" + String(v).replace(/'/g, \"''\") + \"'\"; }\nconst f = flow.get('dev_config') || {};\nif (!f.device_id || !f.device_type) { node.warn('Missing device_id or device_type'); return null; }\nconst extra = {};\nif (f.gateway) extra.gateway = f.gateway;\nif (f.power_attr) extra.power_attr = f.power_attr;\nif (f.attrs_json) { try { extra.attrs = JSON.parse(f.attrs_json); } catch(e) {} }\nif (f.custom_actions_json) { try { extra.custom_actions = JSON.parse(f.custom_actions_json); } catch(e) {} }\nconst vals = [f.device_id, f.device_type, f.location || '', f.friendly_name || '', '1', JSON.stringify(extra)];\nmsg.topic = 'INSERT OR REPLACE INTO device_config (device_id, device_type, location, friendly_name, enabled, extra) VALUES (' + vals.map(esc).join(',') + ')';\nmsg._reload_needed = true;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "sql-l5-add-device",
        "fn-l5-reload-configs"
      ]
    ]
  },
  {
    "id": "sql-l5-add-device",
    "type": "sqlite",
    "z": "tab-l5",
    "name": "INSERT/REPLACE device_config",
    "mydb": "cfg-sqlite-db",
    "sqlquery": "msg.topic",
    "sql": "",
    "wires": []
  },
  {
    "id": "fn-l5-reload-configs",
    "type": "function",
    "z": "tab-l5",
    "name": "Reload configs -> global",
    "func": "const reload = flow.get('_force_reload') || msg._reload_needed;\nif (!reload && !msg._reload_needed) return null;\nmsg.topic = 'SELECT * FROM device_config WHERE enabled = 1';\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "sql-l5-load-configs"
      ]
    ]
  },
  {
    "id": "sql-l5-load-configs",
    "type": "sqlite",
    "z": "tab-l5",
    "name": "SELECT all configs",
    "mydb": "cfg-sqlite-db",
